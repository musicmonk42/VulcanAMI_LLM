{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulcan.example/schemas/graphix/epistemic-v1.json",
  "title": "Graphix Epistemic v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "commit_id",
    "episode_id",
    "case_id",
    "snapshot_digest",
    "authority_principal_id",
    "authority_level",
    "authority_release_digest",
    "validation_digest",
    "policy_digest",
    "authority_evidence_digest",
    "committed_at",
    "claims",
    "evidence",
    "derivations",
    "assumptions",
    "counterexamples",
    "contradictions",
    "prior_commit_digest",
    "commit_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "graphix.epistemic/1"
    },
    "commit_id": {
      "$ref": "#/$defs/id"
    },
    "episode_id": {
      "$ref": "#/$defs/id"
    },
    "case_id": {
      "$ref": "#/$defs/id"
    },
    "snapshot_digest": {
      "$ref": "#/$defs/digest"
    },
    "authority_principal_id": {
      "$ref": "#/$defs/id"
    },
    "committed_at": {
      "type": "string",
      "format": "date-time"
    },
    "prior_commit_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "commit_digest": {
      "$ref": "#/$defs/digest"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "derivations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/derivation"
      }
    },
    "authority_level": {
      "const": "COMMITTED_BELIEF"
    },
    "assumptions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "counterexamples": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/counterexample"
      }
    },
    "contradictions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/contradiction"
      }
    },
    "authority_release_digest": {
      "$ref": "#/$defs/digest"
    },
    "validation_digest": {
      "$ref": "#/$defs/digest"
    },
    "policy_digest": {
      "$ref": "#/$defs/digest"
    },
    "authority_evidence_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{2,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "PROVEN",
        "DISPROVEN",
        "COMPUTED",
        "OBSERVED",
        "RETRIEVED",
        "ESTIMATED",
        "HYPOTHESIS",
        "CONTESTED",
        "UNKNOWN",
        "ERROR"
      ]
    },
    "evidence_kind": {
      "enum": [
        "PROOF",
        "OBSERVATION",
        "RETRIEVAL",
        "COMPUTATION",
        "CITATION",
        "COUNTEREXAMPLE"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "proposition",
        "status",
        "episode_id",
        "snapshot_digest",
        "evidence_ids",
        "derivation_ids",
        "uncertainty",
        "contested_by",
        "supersedes",
        "limitations"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/id"
        },
        "proposition": {
          "$ref": "#/$defs/proposition"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "episode_id": {
          "$ref": "#/$defs/id"
        },
        "snapshot_digest": {
          "$ref": "#/$defs/digest"
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "derivation_ids": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "uncertainty": {
          "$ref": "#/$defs/uncertainty"
        },
        "contested_by": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "limitations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/limitation"
          }
        },
        "supersedes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "kind",
        "episode_id",
        "snapshot_digest",
        "content_digest",
        "provenance_id",
        "observed_at",
        "valid_until",
        "citations",
        "source_episode_id"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "$ref": "#/$defs/evidence_kind"
        },
        "episode_id": {
          "$ref": "#/$defs/id"
        },
        "snapshot_digest": {
          "$ref": "#/$defs/digest"
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        },
        "provenance_id": {
          "$ref": "#/$defs/id"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "citations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "source_episode_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derivation_id",
        "input_claim_ids",
        "evidence_ids",
        "rule_id",
        "output_claim_id"
      ],
      "properties": {
        "derivation_id": {
          "$ref": "#/$defs/id"
        },
        "input_claim_ids": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "rule_id": {
          "$ref": "#/$defs/id"
        },
        "output_claim_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "proposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposition_id",
        "subject",
        "predicate",
        "object_value",
        "qualifiers"
      ],
      "properties": {
        "proposition_id": {
          "$ref": "#/$defs/id"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "predicate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "object_value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "qualifiers": {
          "type": "object"
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "distribution_digest",
        "interval_low",
        "interval_high",
        "calibration_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "UNKNOWN",
            "PROBABILITY_DISTRIBUTION",
            "INTERVAL",
            "CALIBRATION_IDENTITY"
          ]
        },
        "distribution_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "interval_low": {
          "type": [
            "string",
            "null"
          ]
        },
        "interval_high": {
          "type": [
            "string",
            "null"
          ]
        },
        "calibration_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limitation_id",
        "description",
        "affected_claim_ids"
      ],
      "properties": {
        "limitation_id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "affected_claim_ids": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_id",
        "uri",
        "title",
        "artifact_id",
        "artifact_digest"
      ],
      "properties": {
        "citation_id": {
          "$ref": "#/$defs/id"
        },
        "uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifact_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assumption_id",
        "proposition_id"
      ],
      "properties": {
        "assumption_id": {
          "$ref": "#/$defs/id"
        },
        "proposition_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "counterexample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counterexample_id",
        "evidence_id",
        "target_claim_id"
      ],
      "properties": {
        "counterexample_id": {
          "$ref": "#/$defs/id"
        },
        "evidence_id": {
          "$ref": "#/$defs/id"
        },
        "target_claim_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "contradiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contradiction_id",
        "claim_ids"
      ],
      "properties": {
        "contradiction_id": {
          "$ref": "#/$defs/id"
        },
        "claim_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  }
}
